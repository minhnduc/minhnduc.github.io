# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.
PORT=3001
# Chuỗi kết nối MongoDB Atlas, database phải là it4409_rbac
MONGODB_URI=mongodb+srv://minhcuy2001_db_user:<db_password>@cluster0.dmt7mhv.mongodb.net/it4409_rbac?retryWrites=true&w=majority

# Chuỗi ngẫu nhiên tối thiểu 32 ký tự, ví dụ: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Thời gian sống của access token (giây)
ACCESS_TOKEN_TTL=3600
# Các origin của Frontend được phép gọi API, phân tách bằng dấu phẩy
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Chống dò mật khẩu: số lần sai tối đa trong một cửa sổ thời gian (phút)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

